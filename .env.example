# RAVEN configuration template. Copy to .env (never commit .env).
# Read by the backend (raven.config.Settings). No secrets belong here:
# passwords are stored hashed and sessions use random server-side tokens.
# The frontend flag VITE_DATA_SOURCE (api or demo) goes in frontend\.env.local, see frontend\.env.example.
RAVEN_ENV=development
RAVEN_HOST=127.0.0.1
RAVEN_PORT=8000
RAVEN_DATA_DIR=data
RAVEN_LOG_LEVEL=INFO
RAVEN_MAX_UPLOAD_MB=200
RAVEN_SESSION_HOURS=12
# Set to true only when the site is served over https (the cookie then gets the Secure flag).
RAVEN_COOKIE_SECURE=false
# Folder where the VM collector drops JSONL files (the VirtualBox shared folder raven_inbox points here).
RAVEN_INBOX_DIR=data/inbox
# How often the API looks for new collector data, in seconds. 0 switches the watcher off.
RAVEN_INBOX_POLL_SECONDS=5

# Password reset email. Leave RAVEN_SMTP_HOST empty to turn this off: a reset request is still accepted (so a
# missing account is never revealed), it just does not send any mail, and nothing else breaks.
#
# Gmail example (needs 2-Step Verification and an *app password*, not your normal password, from
# https://myaccount.google.com/apppasswords):
#   RAVEN_SMTP_HOST=smtp.gmail.com
#   RAVEN_SMTP_PORT=587
#   RAVEN_SMTP_USE_TLS=true
#   RAVEN_SMTP_USERNAME=you@gmail.com
#   RAVEN_SMTP_PASSWORD=<the 16-character app password>
#   RAVEN_SMTP_FROM_ADDRESS=you@gmail.com
#
# For safe testing without sending to a real inbox, a service such as Mailtrap gives the same 5 settings for a
# sandbox account whose emails you can read in a browser instead of a mailbox.
RAVEN_SMTP_HOST=
RAVEN_SMTP_PORT=587
RAVEN_SMTP_USE_TLS=true
RAVEN_SMTP_USERNAME=
RAVEN_SMTP_PASSWORD=
RAVEN_SMTP_FROM_ADDRESS=
RAVEN_SMTP_FROM_NAME=RAVEN
# Where the frontend runs; used to build the link inside the reset email (http://localhost:5173/reset-password?...).
RAVEN_FRONTEND_BASE_URL=http://localhost:5173
# How long a reset link works for, in hours.
RAVEN_PASSWORD_RESET_HOURS=1
